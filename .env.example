# ═══════════════════════════════════════════════════════════════
# .env.example — Template konfigurasi project
# Salin file ini menjadi .env, lalu isi nilainya.
# JANGAN pernah commit file .env ke Git!
# ═══════════════════════════════════════════════════════════════

# ── Private Key (split 2 segmen untuk keamanan) ─────────────────
# Segmen pertama private key testnet (hex tanpa spasi)
PRIVATE_KEY_TESNET_SEGMEN_PERTAMA=0x...............bagian_pertama...............
# Segmen kedua private key testnet (disambung langsung ke segmen pertama)
PRIVATE_KEY_TESNET_SEGMEN_KEDUA=...............bagian_kedua...............

# ── RPC Endpoint ────────────────────────────────────────────────
# Dapatkan URL dari https://dashboard.alchemy.com
SEPOLIA_URL=https://eth-sepolia.g.alchemy.com/v2/YOUR_ALCHEMY_API_KEY

# ── API Keys ────────────────────────────────────────────────────
# Dapatkan dari https://etherscan.io/myapikey
ETHERSCAN_API_KEY=YOUR_ETHERSCAN_API_KEY

# ── Database & Cache ────────────────────────────────────────────
DATABASE_URL="postgresql://user:pass@localhost:5432/defi_vault?schema=public"
REDIS_URL=redis://localhost:6379

# ── App Config ──────────────────────────────────────────────────
NODE_ENV=development
PORT=3000

# ── Aave Addresses (Sepolia) ────────────────────────────────────
# Pool Addresses Provider Sepolia: https://docs.aave.com/developers/deployed-contracts/v3-testnet-addresses
POOL_ADDRESSES_PROVIDER=0x012bAC54348C08634AA1336EdC8C0f8d9D150Fce

# Underlying token yang dipakai vault (contoh: USDC Sepolia dari Aave faucet)
UNDERLYING_TOKEN=0x94a9D9AC8b2259E409A594E73fB8d60E3881f4F5
# Alias yang sama (keduanya bisa dipakai)
AAVE_UNDERLYING_TOKEN=0x94a9D9AC8b2259E409A594E73fB8d60E3881f4F5

# ── Vault & Adapter Addresses (isi setelah deploy) ───────────────
# Alamat Vault utama yang sudah di-deploy
VAULT_ADDRESS=0xYourDeployedVaultAddress

# Alamat AaveAdapter setelah deploy-aave-adapter.ts berhasil
AAVE_ADAPTER_ADDRESS=0xYourDeployedAaveAdapterAddress

# Alamat CompoundAdapter setelah deploy
COMPOUND_ADAPTER_ADDRESS=0xYourDeployedCompoundAdapterAddress

# ── Network ─────────────────────────────────────────────────────
CHAIN_ID=11155111
